{
  "app": {
    // 签名说明（2026-09-28）：
    //   default = DevEco 自动签名（调试证书，C:\Users\Dang\.ohos\config\default_RockJournal_*），
    //   仅供本机模拟器/真机装机调试 —— ⚠️ 调试证书绑定本机与设备 UDID，路径是本机的，
    //   **不要提交到 CI**（CI 的 build-hap 用 ci product，无签名，见 workflows）。
    //   release = 上架产物，AGC 发布证书待申请（提审前再做，照 RockReader 的 keys/rockreader-v2 流程）。
    "products": [
      {
        // 日常构建产物（HarmonyOS 单框架 6.x）：装机调试用
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "5.0.4(16)",
        "targetSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {}
      },
      {
        // CI 专用：用公开可下载的 OpenHarmony SDK 做编译校验（HarmonyOS SDK 下载需登录华为账号）
        // 目的 = 在 CI 上验证 ArkTS/ArkUI 代码能编译通过；正式包等签名证书到位后由 default 产物出
        // 注：runtimeOS=OpenHarmony 时 hvigor 要求显式给出 compileSdkVersion，否则报 00303034
        "name": "ci",
        "compileSdkVersion": 20,
        "compatibleSdkVersion": 20,
        "runtimeOS": "OpenHarmony",
        "buildOption": {}
      },
      {
        // **向下兼容的编译证据**（照 RockReader 2026-09-24 的做法）：
        // 拿公开 SDK 里最低可用的 5.0.3-Release = API 15 编译：通过 ⇒ 代码不含 16+ 的 API
        // ⇒ 将来声明 compatibleSdkVersion 16 有编译证据（"用更严的条件证明更松的声明"）。
        // ⚠️ 这个 product 只做编译校验，不动正式包的任何配置。
        "name": "compat15",
        "compileSdkVersion": 15,
        "compatibleSdkVersion": 15,
        "runtimeOS": "OpenHarmony",
        "buildOption": {}
      },
      // ── 正式产物（2026-10-20 接上 AGC 发布签名，可出 signed .app 提审）──
      {
        // **上架发布产物**：Build App 出 .app 包（AGC 提审用）。
        // 签名 = 复用 RockReader 的 AGC 发布证书（华为个人账号全账号仅 1 张发布证书，
        // 多应用共用是官方常规做法），只为 Rock私记包名单独申请了发布 Profile：
        //   keys/rockjournal-v1.p7b（内含 com.rocktier.rockjournal，2026-10-20 从 AGC 下载）
        "name": "release",
        "signingConfig": "release",
        "compatibleSdkVersion": "5.0.4(16)",
        "targetSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {}
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ],
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "C:\\Users\\Dang\\.ohos\\config\\default_RockJournal_-p2vtLEhKneOX_JOJ5IP7GOUeFbxhtuP9YNypEWGIUM=.cer",
          "keyAlias": "debugKey",
          "keyPassword": "0000001BEDC1214E5D6AE82125E1065F74BA3AD8CCEFC37255A57848A69C8A5EACC0E2CBEAAD03B3D81A8A",
          "profile": "C:\\Users\\Dang\\.ohos\\config\\default_RockJournal_-p2vtLEhKneOX_JOJ5IP7GOUeFbxhtuP9YNypEWGIUM=.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "C:\\Users\\Dang\\.ohos\\config\\default_RockJournal_-p2vtLEhKneOX_JOJ5IP7GOUeFbxhtuP9YNypEWGIUM=.p12",
          "storePassword": "0000001BCF15641E5C9ABA1D0DE7AF30BE3631619DE0E395893A2D07BE8EAF4709D433FCABFA9B94091D26"
        }
      },
      {
        // **上架发布签名**（2026-10-20）：复用 AGC 上 rockreader-v2 那张发布证书
        // （个人开发者账号全账号仅 1 张发布证书，多应用共用是官方常规做法），
        // Profile 用 Rock私记专属的 rockjournal-v1.p7b（绑定 com.rocktier.rockjournal）。
        // 明文口令仅存本机 F:\AI\HarmonyOS\keys\rockreader-v2-password.txt，工程不公开。
        "name": "release",
        "type": "HarmonyOS",
        "material": {
          // 口令字段 = DevEco 加密串（明文直填 hvigor 会报 00303116/00303117）。
          // 这两个串是同机 DevEco 对同一把钥匙（rockreader-v2.p12 同一口令）生成的，
          // 与 RockReader 的 release signingConfig 完全一致；明文见
          // F:\AI\HarmonyOS\keys\rockreader-v2-password.txt（不进 git）。
          "storeFile": "F:/AI/HarmonyOS/keys/rockreader-v2.p12",
          "storePassword": "00000031255ED0D0D73CF05F75F767176D250A3FE6FB9DDA03C858110A9A78CFA27D2DF64B7204B29C9E19F1324540B3BF380FFADAC4EA01C0BE7D2BCFC9FA99AE",
          "keyAlias": "rockreader-v2",
          "keyPassword": "00000031EF025B173DDC7EDCBA7FCB8FC66A69456FD91CB9F650A8B1A27C60593CB50C42BBB5E9694140CCD8A8D4F2A9228EEE2884017955EB3A861FAFA750E1AB",
          "signAlg": "SHA256withECDSA",
          "profile": "F:/AI/HarmonyOS/keys/rockjournal-v1.p7b",
          "certpath": "F:/AI/HarmonyOS/keys/rockreader-v2.cer"
        }
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default",
            "ci",
            "compat15",
            "release"
          ]
        }
      ]
    }
  ]
}
